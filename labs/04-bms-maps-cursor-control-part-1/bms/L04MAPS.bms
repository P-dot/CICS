* Final Part 1 logical source excerpt.
* Keep fixed-format BMS continuation rules when recreating on z/OS.
L04MAPS DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,
               STORAGE=AUTO,CTRL=FREEKB,TIOAPFX=YES
L04MAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(3,22),LENGTH=36,ATTRB=(ASKIP,NORM),
               INITIAL='************************************'
         DFHMDF POS=(5,25),LENGTH=30,ATTRB=(ASKIP,BRT),
               INITIAL='CICS LAB 04'
         DFHMDF POS=(7,18),LENGTH=44,ATTRB=(ASKIP,NORM),
               INITIAL='BMS MAPS AND CURSOR CONTROL'
         DFHMDF POS=(10,18),LENGTH=10,ATTRB=(ASKIP,NORM),
               INITIAL='USER NAME:'
USERNM   DFHMDF POS=(10,30),LENGTH=12,ATTRB=(UNPROT),
               INITIAL=' '
         DFHMDF POS=(14,22),LENGTH=30,ATTRB=(ASKIP,NORM),
               INITIAL='ENTER=CONTINUE'
         DFHMDF POS=(18,22),LENGTH=36,ATTRB=(ASKIP,NORM),
               INITIAL='************************************'
         DFHMSD TYPE=FINAL
         END
